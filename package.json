{
  "name": "portfoliov3",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "description": "The third iteration of my portfolio",
  "main": "index.js",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest run --watch",
    "dev:server": "NODE_ENV=development tsx watch app/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:server": "tsc -p tsconfig.json",
    "build": "npm run build:server && npm run build --workspace frontend",
    "prepare": "node .husky/install.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tw-research/portfoliov3.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/tw-research/portfoliov3/issues"
  },
  "homepage": "https://github.com/tw-research/portfoliov3#readme",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@tiptap/core": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@tiptap/static-renderer": "^3.32.2",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "openid-client": "^6.8.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
