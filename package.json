  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  },
